# ==============================================================================
# RackMind AI (TwinOps) — Environment Configuration Template
# Google Cloud AI Builder Cup 2026 Submission
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls and real-time Search Grounding.
# Obtain your API key from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Application environment mode ('development' or 'production')
NODE_ENV="development"

# APP_URL: The base URL where this application or digital twin is hosted.
# Used for self-referential links, OAuth callbacks, and API proxy endpoints.
APP_URL="http://localhost:3000"
