rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read, write: if true;
    }
    match /copilot_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /incidents/{incidentId} {
      allow read, write: if true;
    }
  }
}
